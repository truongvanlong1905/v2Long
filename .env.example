# Toan Trung V2 — Environment Configuration Template
# Put real values in ignored local .env files or the deployment secret store.
# Never add secrets to NEXT_PUBLIC_* variables or commit credentials.

# Database connection (Local demo: SQLite; Production: PostgreSQL)
DATABASE_URL="file:./dev.db"

# Server-side session signing secret (minimum 32 random bytes in production)
SESSION_SECRET="replace-with-at-least-32-bytes-random-secret-key"

# Protected local storage directory for branding assets & uploads
STORAGE_ROOT="./storage"

# Environment mode (development | test | production)
NODE_ENV="development"
